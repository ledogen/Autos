# macOS
.DS_Store

# Logs
Logs/
*.log

# npm deps (three/simplex for the runtime bundle + vite; also the pure-node test gates)
node_modules/

# Vite build output — rebuilt by .github/workflows/deploy.yml and deployed as a Pages artifact;
# never committed (keeps source clean, per the PERF-04/PERF-20.5 deploy design).
dist/
# …but the VENDORED box3d bindings ship a dist/ of their own (FEAT-48) that must commit —
# vendoring is the owner's insurance against the upstream package going stale.
!vendor/box3d/dist/

# Claude Code local harness state (volatile / per-machine)
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/settings.local.json

# ── Screenshots / image + video captures (agentic verification & planning artifacts) ──
# Broad net so a stray capture (e.g. an in-browser CDP screenshot, or an image dropped into
# a .planning/ doc) can't be `git add`ed by accident. .gitignore only gates UNtracked files,
# so already-committed art (references/*.png, assets/models/*.glb) is unaffected. Real binary
# assets live under assets/ and references/ — un-ignored below so they still commit normally.
# To intentionally add a new image elsewhere: `git add -f <file>`.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.heic
*.mp4
*.mov
*.webm
*.avif

# Keep the real asset directories addable (negate the patterns above for these paths)
!assets/**
!references/**

# …but the negation above is broad enough to re-admit Finder droppings under those paths, which is
# how assets/.DS_Store came back after the macOS rule at the top of this file already excluded it.
# Last matching pattern wins, so this has to sit BELOW the negations, not beside its sibling rule.
**/.DS_Store

# Common scratch / capture dump locations
screenshots/
captures/
*.screenshot.*

# Blender autosave backups beside the asset sources (assets/models/src/*.blend1)
*.blend1

# Python bytecode from running an asset generator via importlib in Blender
__pycache__/

# PERF-08 profiling harness output (test/profile.mjs) — traces are tens of MB, per-machine
perf-runs/

# Planning-dashboard index (tools/dashboard) — regenerated on every `npm run dash`
tools/dashboard/tickets.json
tools/dashboard/stats.json
