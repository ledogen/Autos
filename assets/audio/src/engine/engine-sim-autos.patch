+// AUTOS headless renderer for engine-sim (FEAT-120 engine bake).
+//
+// Runs the simulation offline, without a window or audio device, and writes the synthesizer's
+// output straight to a 32-bit float WAV at 44.1 kHz. The leveler (an always-on fast compressor in
+// the app) is pinned to a fixed gain, so relative loudness between takes is real.
+//
+// Usage (run from engine-sim's bin/ folder, like the app, so "../es/" and "../assets/" resolve):
+//   engine-sim-render <script.mr> --out take.wav --rpm 2340 --throttle 0.3 [options]
+//   engine-sim-render <script.mr> --out idle.wav --free-idle [--throttle 0] [options]
+//   engine-sim-render <script.mr> --sweep 1000:5500:250 --throttle 1     (dyno table, CSV to stdout)
+//
+// Options:
+//   --warmup S     seconds simulated before recording starts (default 3)
+//   --seconds S    seconds recorded (default 6)
+//   --gain G       fixed leveler gain (default 1). The app's leveler adapts between 1e-5 and 1.9.
+//   --volume V     synthesizer volume, applied after the leveler (default 1)
+//   --noise N      override the script's `noise` (V knob)
+//   --jitter J     override the script's `jitter` (B knob)
+//   --hf H         override the script's `hf_gain` (C knob)
+//   --seed N       random seed for the synthesizer's noise (default 1)
+//   --ir WAV       replace every exhaust's impulse response with this 16-bit WAV (e.g. a unit
+//                  impulse for dry takes); the script's own IRs are used otherwise
+//   --ir-volume V  volume for --ir (default 0.01, the library's scale)
+//
+// <script.mr> must call main(), like assets/main.mr. One summary line of JSON goes to stdout.
+
+#include "../include/engine.h"
+#include "../include/simulator.h"
+#include "../include/synthesizer.h"
+#include "../include/vehicle.h"
+#include "../include/transmission.h"
+#include "../include/impulse_response.h"
+#include "../include/exhaust_system.h"
+#include "../include/units.h"
+#include "../include/constants.h"
+#include "../scripting/include/compiler.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#define NOMINMAX
+#include <windows.h>
+#include <dbghelp.h>
+#pragma comment(lib, "dbghelp.lib")
